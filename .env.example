# Copy this file to .env and fill with local values
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/appdb
JWT_SECRET=replace-with-a-long-random-secret

# Social automation switches
SOCIAL_AUTOMATION_ENABLED=false
SOCIAL_DEFAULT_LINK=https://example.com

# Telegram
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# X (Twitter)
X_API_KEY=CHANGE_ME
X_API_SECRET=CHANGE_ME
X_BEARER_TOKEN=CHANGE_ME
X_CLIENT_ID=CHANGE_ME
X_CLIENT_SECRET=CHANGE_ME
X_ACCESS_TOKEN=CHANGE_ME
X_ACCESS_TOKEN_SECRET=CHANGE_ME

# Discord
DISCORD_BOT_TOKEN=CHANGE_ME
DISCORD_APPLICATION_ID=CHANGE_ME
DISCORD_PUBLIC_KEY=CHANGE_ME
DISCORD_CHANNEL_ID=CHANGE_ME

# Facebook
FACEBOOK_APP_ID=CHANGE_ME
FACEBOOK_APP_SECRET=CHANGE_ME
FACEBOOK_PAGE_ID=CHANGE_ME
FACEBOOK_PAGE_ACCESS_TOKEN=CHANGE_ME

# LinkedIn
LINKEDIN_CLIENT_ID=CHANGE_ME
LINKEDIN_CLIENT_SECRET=CHANGE_ME
LINKEDIN_REDIRECT_URI=http://localhost:8787/integrations/linkedin/oauth/callback
LINKEDIN_ORG_ID=CHANGE_ME
LINKEDIN_AD_ACCOUNT_ID=CHANGE_ME
LINKEDIN_DEFAULT_CAMPAIGN_ID=
LINKEDIN_OAUTH_SCOPES=r_ads_reporting w_organization_social rw_organization_admin
LINKEDIN_ACCESS_TOKEN=CHANGE_ME

# Billing gateways
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME
PAYPAL_MODE=sandbox

# Checkout redirects (must be real, never example.com)
STRIPE_RETURN_URL=http://localhost:4310/billing/success
STRIPE_CANCEL_URL=http://localhost:4310/billing/cancel
PAYPAL_RETURN_URL=http://localhost:4310/billing/success
PAYPAL_CANCEL_URL=http://localhost:4310/billing/cancel

# SAT / CFDI automation (Facturama + Resend)
INVOICE_PROVIDER=facturama
FACTURAMA_API_KEY=CHANGE_ME
FACTURAMA_API_SECRET=CHANGE_ME
FACTURAMA_API_BASE_URL=https://apisandbox.facturama.mx
RESEND_API_KEY=CHANGE_ME
BILLING_FROM_EMAIL=billing@yourdomain.com
BILLING_SELLER_EMAIL=sales@yourdomain.com
BILLING_ACCOUNTANT_EMAIL=accounting@yourdomain.com
INVOICE_AUTOMATION_STRICT=true
