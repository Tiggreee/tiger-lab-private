{
  "name": "tiger-lab-private",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private internal lab for advanced full-stack, DevOps, and AI projects",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:e2e": "vitest run tests/e2e",
    "test:smoke": "vitest run tests/smoke",
    "test:coverage": "vitest run --coverage",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:contract && npm run test:e2e && npm run test:smoke && npm run test:coverage",
    "test:server-mode": "vitest run tests/e2e/server-mode",
    "test:automation-flow": "vitest run tests/e2e/funnel",
    "generate-proposal": "node scripts/generate-proposal.mjs",
    "generate-outreach": "node scripts/generate-outreach.mjs",
    "generate-proposal:example": "node scripts/generate-proposal.mjs --client \"Cliente Demo\" --problem \"conciliacion manual de facturas\" --duration \"10 dias\" --tier1_price \"800\" --tier2_price \"1,500\" --tier3_price \"2,500\"",
    "generate-outreach:example": "node scripts/generate-outreach.mjs --leads '[{\"name\":\"Carlos\",\"company\":\"Facturapi MX\",\"industry\":\"fintech\",\"pain\":\"conciliacion manual\",\"process\":\"reconciliacion de pagos\"},{\"name\":\"Maria\",\"company\":\"DevOps SMB\",\"industry\":\"technology\",\"pain\":\"deploy manual\",\"process\":\"deploys a produccion\"}]'",
    "products:list": "node scripts/show-products.mjs",
    "policy:check": "node scripts/github-policy-check.mjs",
    "leads:generate": "node scripts/lead-intelligence.mjs",
    "dashboard:prioritize": "node scripts/dashboard-prioritize.mjs",
    "generate-product": "node scripts/generate-product.mjs",
    "generate-content": "node scripts/generate-content.mjs",
    "publish-content": "node scripts/publish-content.mjs",
    "capture-lead": "node scripts/capture-lead.mjs",
    "provision-product": "node scripts/provision-product.mjs",
    "analyze-monetization": "node scripts/analyze-monetization.mjs",
    "build:server": "tsx --check server/start-server.ts",
    "build:ui": "cd ui-host && npm ci && npm run build",
    "build:full": "npm run build:server && npm run build:ui",
    "build": "npm run build:full",
    "server:mode": "node server/copilot-server.mjs",
    "server:start": "tsx server/start-server.ts",
    "start": "npm run server:start",
    "server:client:test": "node scripts/server-mode-test-client.mjs",
    "check:secrets": "bash ./scripts/verify-secrets.sh",
    "check:secrets:social": "node scripts/validate-social-secrets.mjs",
    "check:secrets:all": "npm run check:secrets && npm run check:secrets:social",
    "traffic:ready": "node scripts/traffic/check-social-ready.mjs",
    "traffic:pack": "node scripts/traffic/generate-social-pack.mjs",
    "traffic:threads:fetch": "node scripts/traffic/fetch-real-threads.mjs",
    "traffic:pack:threaded": "node scripts/traffic/generate-thread-backed-social-pack.mjs",
    "traffic:cards": "node scripts/traffic/generate-campaign-cards.mjs",
    "traffic:threads:build": "node scripts/traffic/build-research-threads.mjs",
    "traffic:pack:audit": "node scripts/traffic/generate-audit-campaigns.mjs",
    "traffic:publish": "node scripts/traffic/publish-social-pack.mjs",
    "traffic:publish:dry": "node scripts/traffic/publish-social-pack.mjs --dry-run",
    "traffic:go-live": "node scripts/traffic/check-go-live.mjs",
    "traffic:ready:gh": "node scripts/traffic/check-social-ready.mjs --githubRepo Tigre-Labs/tiger-lab-private --githubEnv production-social",
    "traffic:go-live:gh": "node scripts/traffic/check-go-live.mjs --githubRepo Tigre-Labs/tiger-lab-private --githubEnv production-social",
    "traffic:validate:gh": "npm run traffic:ready:gh && npm run traffic:go-live:gh",
    "traffic:autopilot": "node scripts/traffic/run-autopilot.mjs",
    "traffic:pipeline": "node scripts/traffic/run-full-campaign-pipeline.mjs",
    "traffic:pipeline:dry": "node scripts/traffic/run-full-campaign-pipeline.mjs --dryRun",
    "campaigns:folders:run": "node scripts/traffic/run-folder-campaign-worker.mjs",
    "campaigns:pending": "node scripts/traffic/campaign-approval.mjs --pending",
    "campaigns:approve": "node scripts/traffic/campaign-approval.mjs --approve",
    "campaigns:reject": "node scripts/traffic/campaign-approval.mjs --reject",
    "campaigns:expire": "node scripts/traffic/campaign-approval.mjs --expire",
    "campaigns:index:sync": "node scripts/traffic/sync-runtime-campaign-index.mjs",
    "campaigns:index:check": "node scripts/traffic/check-runtime-campaign-index-alignment.mjs",
    "traffic:validate": "node scripts/validate-campaigns.mjs",
    "product:operability": "node scripts/product-operability-report.mjs",
    "traffic:setup": "bash scripts/traffic/setup-social-secrets.sh",
    "traffic:activate": "npm run traffic:ready && npm run traffic:pack",
    "ci:local": "npm run test && npm run check:secrets",
    "revenue:forecast": "node scripts/revenue-forecast.mjs",
    "revenue:forecast:example": "node scripts/revenue-forecast.mjs ops/revenue/forecast.example.json",
    "command-center:start": "node scripts/serve-command-center.mjs",
    "command-center:summary": "node scripts/command-center-summary.mjs",
    "supervisor:sync": "node scripts/supervisor-sync-command-center.mjs",
    "supervisor:sync:example": "node scripts/supervisor-sync-command-center.mjs ops/supervisor/latest-supervisor-report.example.json",
    "pipeline:summary": "node scripts/pipeline-weekly-summary.mjs",
    "pipeline:summary:md": "node scripts/pipeline-weekly-summary.mjs --markdown",
    "revenue:daily": "node scripts/revenue-daily-dashboard.mjs",
    "revenue:daily:md": "node scripts/revenue-daily-dashboard.mjs --markdown",
    "billing:reconcile": "node scripts/billing-reconciliation.mjs",
    "billing:reconcile:md": "node scripts/billing-reconciliation.mjs --markdown",
    "billing:reconcile:strict": "node scripts/billing-reconciliation.mjs --strict",
    "billing:sat:check": "node scripts/check-sat-billing-env.mjs",
    "billing:invoice:retry": "tsx scripts/adapters/run-invoice-retry.ts",
    "billing:invoice:retry:strict": "tsx scripts/adapters/run-invoice-retry.ts --strict",
    "timbox:adapter:start": "node scripts/start-timbox-adapter.mjs",
    "timbox:manifiesto:firmar": "node scripts/timbox-sign-manifest.mjs",
    "timbox:manifiesto:check": "node scripts/timbox-manifest-e2e-check.mjs",
    "timbox:manifiesto:check:strict": "node scripts/timbox-manifest-e2e-check.mjs --strict",
    "timbox:cancelar": "node scripts/timbox-cancel-cfdi.mjs",
    "timbox:cfdi:inspect": "node scripts/timbox-cfdi-inspect.mjs",
    "timbox:cfdi:inspect:strict": "node scripts/timbox-cfdi-inspect.mjs --strict",
    "timbox:staging:flow": "node scripts/timbox-run-staging-flow.mjs",
    "invoice:pending": "node scripts/invoice-pending-report.mjs",
    "invoice:pending:md": "node scripts/invoice-pending-report.mjs --markdown",
    "traffic:sla": "node scripts/traffic/check-lead-sla.mjs",
    "git:start:feature": "bash scripts/git/start-feature.sh",
    "git:start:hotfix": "bash scripts/git/start-hotfix.sh",
    "git:weekly:check": "bash scripts/git/weekly-release-check.sh",
    "check:copilot:agents": "node scripts/validate-copilot-agents.mjs",
    "prod:gate": "node scripts/production-go-no-go.mjs",
    "prod:gate:strict": "node scripts/production-go-no-go.mjs --strict",
    "prod:dashboard:smoke": "node scripts/production-dashboard-smoke.mjs",
    "prod:trial:preflight": "node scripts/production-trial-preflight.mjs",
    "prod:trial:preflight:full": "node scripts/production-trial-preflight.mjs --with-social",
    "prod:trial:preflight:strict": "node scripts/production-trial-preflight.mjs --with-social --strict",
    "decisions:sync": "node ops/command-center/decisions-sync.mjs",
    "decisions:api": "curl -s http://localhost:8787/decisions | node -e \"process.stdin.resume(); let d=''; process.stdin.on('data',c=>d+=c); process.stdin.on('end',()=>console.log(JSON.stringify(JSON.parse(d),null,2)))\"",
    "packages:build": "npm pack",
    "packages:publish:dry": "npm run test:all && npm pack",
    "cost-guard:audit": "node scripts/github-resource-audit.mjs",
    "mcp:list": "node engine/runtime/mcp-client.mjs --list",
    "mcp:verify": "node engine/runtime/mcp-client.mjs --verify",
    "lead:seed": "node scripts/lead-engine.mjs --mode seed",
    "lead:enrich": "node scripts/lead-engine.mjs --mode enrich",
    "lead:export": "node scripts/lead-engine.mjs --mode export",
    "lead:engine": "node scripts/lead-engine.mjs --mode auto",
    "impl:track": "node scripts/implementation-tracker.mjs",
    "db:init": "node scripts/init-database.mjs",
    "prod:engine": "node scripts/product-development-engine.mjs",
    "prod:engine:status": "node scripts/product-development-engine.mjs --summary-only",
    "prod:factory": "node engine/runtime/product-factory.mjs",
    "rnd:discover": "node engine/rnd/rnd-engine.mjs --scan",
    "rnd:materialize": "node engine/rnd/idea-materializer.mjs",
    "llm:status": "node engine/llm/llm-port.mjs",
    "github:resource:audit": "node scripts/github-resource-audit.mjs"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.9",
    "mjml": "^5.4.0",
    "puppeteer": "^25.3.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "sql.js": "^1.14.1",
    "tsx": "^4.22.5"
  }
}
